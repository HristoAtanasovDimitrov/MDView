{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MDView",
  "version": "2.0.0",
  "identifier": "com.hristodimitrov.mdview",
  "build": {
    "frontendDist": "../src",
    "beforeDevCommand": "node sync.js",
    "beforeBuildCommand": "node sync.js"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "MDView",
        "width": 1150,
        "height": 820,
        "minWidth": 480,
        "minHeight": 360,
        "backgroundColor": "#14161c"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "appimage", "deb"],
    "icon": ["icons/icon.ico", "icons/icon.icns", "icons/icon.png"],
    "category": "Productivity",
    "shortDescription": "Dark markdown viewer and editor",
    "fileAssociations": [
      {
        "ext": ["md", "markdown", "mdown"],
        "name": "MDView.Markdown",
        "description": "Markdown Document",
        "mimeType": "text/markdown",
        "role": "Editor"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "linux": {
      "deb": {
        "section": "utils"
      }
    }
  }
}
