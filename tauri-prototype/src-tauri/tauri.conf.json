{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MDView",
  "version": "1.5.0",
  "identifier": "com.hristodimitrov.mdview",
  "build": {
    "frontendDist": "../src",
    "beforeDevCommand": "node sync.js",
    "beforeBuildCommand": "node sync.js"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "MDView",
        "width": 1150,
        "height": 820,
        "minWidth": 480,
        "minHeight": 360,
        "backgroundColor": "#14161c"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "fileAssociations": [
      {
        "ext": ["md", "markdown", "mdown"],
        "name": "Markdown Document",
        "description": "Markdown document",
        "role": "Editor"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
